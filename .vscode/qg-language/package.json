{
    "name": "qg-language",
    "displayName": "QG Language",
    "description": "QG syntax highlighting and snippets",
    "publisher": "local",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "contributes": {
        "languages": [
            {
                "id": "qg",
                "aliases": [
                    "QG",
                    "QG Language"
                ],
                "extensions": [
                    ".qg"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "qg",
                "scopeName": "source.qg",
                "path": "./syntaxes/qg.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "qg",
                "path": "./snippets.json"
            }
        ]
    }
}
