{
    "Game loop": {
        "prefix": "game",
        "body": [
            "canvas(${1:300},${2:400});",
            "",
            "fn update(t){",
            "    clear('${3:#101020}');",
            "    $0",
            "    frame(update);",
            "}",
            "",
            "frame(update);"
        ]
    },
    "Touch handler": {
        "prefix": "touch",
        "body": [
            "touch(fn(x,y){",
            "    $0",
            "});"
        ]
    },
    "Palette": {
        "prefix": "palette",
        "body": [
            "palette ${1:colors}=[null,'#ffffff','#5599ff','#224488','#ff9922','#886644','#443322','#bb9977'];"
        ]
    },
    "Sprite": {
        "prefix": "sprite",
        "body": [
            "sprite ${1:ship}(${2:colors}){",
            "    ${3:010}",
            "    111",
            "    010",
            "}"
        ]
    }
}
